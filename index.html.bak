<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags -->
  <title>Wisphot (విస్ఫోట) | Hyderabad's Most Explosive Wrap Experience</title>
  <meta name="description" content="Craving bold, spicy, and addictive chicken wraps inside Next Galleria Mall, Punjagutta? Taste the legendary Nuclear Bomb Wrap at Wisphot. Order online today!">
  <meta name="keywords" content="Wisphot, Wisphot Hyderabad, Nuclear Bomb Chicken Wrap, Spicy food Hyderabad, Punjagutta wraps, Fast food Next Galleria Mall, Hyderabad food court">
  <meta name="author" content="Wisphot">
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://wisphot.com/">
  <meta property="og:title" content="Wisphot (విస్ఫోట) | Hyderabad's Most Explosive Wrap Experience">
  <meta property="og:description" content="Craving bold, spicy, and addictive chicken wraps inside Next Galleria Mall? Taste the legendary Nuclear Bomb Wrap. Dine-in, Takeaway, and Delivery available.">
  <meta property="og:image" content="assets/nuclear_bomb_wrap.png">

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="assets/nuclear_bomb_wrap.png">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="style.css">

  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <!-- ------------------------------------------------------------------------
       Navigation Header
       ------------------------------------------------------------------------ -->
  <header class="glass">
    <a href="#" class="logo" id="site-logo">
      WISPHOT <span class="telugu-logo">విస్ఫోట</span>
    </a>
    
    <nav id="main-nav">
      <ul>
        <li><a href="#hero" class="nav-link">Home</a></li>
        <li><a href="#about" class="nav-link">Our Vibe</a></li>
        <li><a href="#menu" class="nav-link">Menu</a></li>
        <li><a href="#why-us" class="nav-link">Why Us</a></li>
        <li><a href="#reviews" class="nav-link">Reviews</a></li>
        <li><a href="#gallery" class="nav-link">Gallery</a></li>
        <li><a href="#faq" class="nav-link">FAQs</a></li>
      </ul>
    </nav>
    
    <div class="nav-actions">
      <button class="cart-icon-btn" id="open-cart-btn" aria-label="Open Shopping Cart">
        <i class="fa-solid fa-bag-shopping"></i>
        <span class="cart-badge" id="cart-badge-count">0</span>
      </button>
      <button class="glow-btn" id="nav-book-btn">
        <i class="fa-regular fa-calendar-days"></i> Book Table
      </button>
      <div class="mobile-menu-btn" id="menu-toggle-btn">
        <i class="fa-solid fa-bars-staggered"></i>
      </div>
    </div>
  </header>

  <!-- ------------------------------------------------------------------------
       Hero Section
       ------------------------------------------------------------------------ -->
  <section class="hero" id="hero">
    <div class="hero-content reveal-left">
      <div class="badge-wrapper">
        <div class="hero-badge rating">
          <i class="fa-solid fa-star"></i> <span>4.5</span> (130+ Reviews)
        </div>
        <div class="hero-badge">
          <i class="fa-solid fa-fire"></i> Built for Spice Lovers
        </div>
      </div>
      
      <h1>
        Hyderabad's Most
        <span class="text-gradient">Explosive</span>
        Wrap Experience
        <span class="text-gradient telugu-word">విస్ఫోట</span>
      </h1>
      
      <p>
        Bold flavors, addictive wraps, molten cheese cores, and unforgettable street-food bites — all served fresh inside Next Galleria Mall, Punjagutta.
      </p>
      
      <div class="hero-actions">
        <button class="glow-btn" id="hero-order-btn">
          <i class="fa-solid fa-utensils"></i> Order Online
        </button>
        <a href="#menu" class="outline-btn">
          <i class="fa-solid fa-book-open"></i> View Menu
        </a>
      </div>
      
      <div class="hero-stats">
        <div class="stat-item">
          <h3>₹200+</h3>
          <p>Super Budget Friendly</p>
        </div>
        <div class="stat-item">
          <h3>20+</h3>
          <p>Unique Fusion Items</p>
        </div>
        <div class="stat-item">
          <h3>5th</h3>
          <p>Floor Galleria Mall</p>
        </div>
      </div>
    </div>
    
    <div class="hero-visual reveal-right">
      <div class="food-circle-glow"></div>
      <img src="assets/nuclear_bomb_wrap.png" alt="Signature Nuclear Bomb Chicken Wrap" class="hero-main-img" id="hero-interactive-img">
      
      <!-- Floating Card 1 -->
      <div class="floating-card card-1 glass">
        <img src="assets/signature_fries.png" alt="Signature Fries Preview">
        <div>
          <h4>Signature Fries</h4>
          <span>Spicy & Loaded</span>
        </div>
      </div>
      
      <!-- Floating Card 2 -->
      <div class="floating-card card-2 glass">
        <img src="assets/choco_pie_cookie.png" alt="Choco Pie Cookie Preview">
        <div>
          <h4>Choco Pie Cookie</h4>
          <span>Warm & Molten</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------------------
       About Section
       ------------------------------------------------------------------------ -->
  <section class="about" id="about">
    <div class="about-visual reveal-left">
      <img src="assets/neon_outlet_vibe.png" alt="Wisphot Trendy Mall Outlet Vibe">
      <div class="vibe-tag glass">
        <i class="fa-solid fa-camera"></i> Instagram Worthy
      </div>
    </div>
    
    <div class="about-content reveal-right">
      <span class="section-tag">Crunch. Spice. Repeat.</span>
      <h2 class="section-title">The Street Food Revolution Hyderabad Needed</h2>
      <p>
        At Wisphot, we don't do boring fast food. We are a bold, youth-centric, women-owned brand serving up explosive fusion flavors inspired by modern street food culture. 
      </p>
      <p>
        We craft spicy signature wraps, pockets, and fries that pack a serious punch, while keeping our prices ridiculously friendly. Located inside the premium Next Galleria Mall food court, we've created a vibrant, inclusive hangout spot where great vibes meet dangerously addictive food.
      </p>
      
      <div class="about-highlights">
        <div class="highlight-box">
          <i class="fa-solid fa-venus"></i>
          <div>
            <h4>Women-Owned</h4>
            <p>Empowering local culinary creativity and modern leadership.</p>
          </div>
        </div>
        <div class="highlight-box">
          <i class="fa-solid fa-rainbow"></i>
          <div>
            <h4>LGBTQ+ Friendly</h4>
            <p>A safe, inclusive hangout space built for everyone in Hyderabad.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------------------------
       Signature Menu Section
       ------------------------------------------------------------------------ -->
  <section class="menu-section" id="menu">
    <div class="menu-header reveal">
      <span class="section-tag">Explore Flavors</span>
      <h2 class="section-title">Warning: Dangerously Addictive</h2>
      <p>Hand-crafted with fresh, fiery ingredients and local Indian fusion spices. Choose your weapons below.</p>
    </div>
    
    <div class="menu-filters reveal">
      <button class="filter-btn active" data-filter="all">All Items</button>
      <button class="filter-btn" data-filter="wrap">Spicy Wraps</button>
      <button class="filter-btn" data-filter="side">Sides & Fries</button>
      <button class="filter-btn" data-filter="dessert">Cakes & Desserts</button>
    </div>
    
    <div class="menu-container">
      
      <!-- Group 1: Spicy Wraps -->
      <div class="menu-group" data-category="wrap">
        <div class="menu-group-title">
          <i class="fa-solid fa-pepper-hot"></i> Signature & Everyday Wraps
        </div>
        <p class="menu-group-subtitle">Fiery rolled goodness. Customize your paratha base and protein style below.</p>
        <div class="menu-grid">

          <!-- Item 1: The OG -->
          <div class="menu-card glass">
            <div class="card-img-wrapper">
              <img src="assets/nuclear_bomb_wrap.png" alt="The OG Wrap">
              <span class="card-tag hot">Best Seller</span>
            </div>
            <div class="card-details">
              <h3>THE OG</h3>
              <p>Embrace a medley of crisp, fresh vegetables alongside tender, succulent protein enveloped in a delectable sauce that ignites the palate.</p>
              
              <!-- Customizations -->
              <div class="card-options">
                <div class="option-select-row">
                  <label for="paratha-choice-the-og">Choose Your Paratha</label>
                  <select id="paratha-choice-the-og" class="card-select item-paratha-choice">
                    <option value="Whole Wheat">Whole Wheat (Healthy)</option>
                    <option value="Maida" selected>Maida</option>
                    <option value="Fried Paratha">Fried Paratha</option>
                  </select>
                </div>
                <div class="option-select-row">
                  <label for="protein-choice-the-og">Protein Style</label>
                  <select id="protein-choice-the-og" class="card-select item-protein-choice">
                    <option value="Paneer">Paneer (Veg)</option>
                    <option value="Chicken" selected>Chicken (Non-Veg)</option>
                  </select>
                </div>
              </div>

              <div class="card-footer">
                <span class="card-price">₹289</span>
                <button class="add-to-cart-btn" data-id="the-og" data-name="THE OG" data-price="289" data-img="assets/nuclear_bomb_wrap.png" aria-label="Add THE OG to Cart">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Item 2: Jubilee Hills -->
          <div class="menu-card glass">
            <div class="card-img-wrapper">
              <img src="assets/nuclear_bomb_wrap.png" alt="Jubilee Hills Wrap">
              <span class="card-tag hot">New Arrival</span>
            </div>
            <div class="card-details">
              <h3>JUBILEE HILLS</h3>
              <p>Crispy fried Paneer/Chicken finds its home within a golden, crisp paratha, accompanied by vibrant veggies and delectable sauces.</p>
              
              <!-- Customizations -->
              <div class="card-options">
                <div class="option-select-row">
                  <label for="paratha-choice-jubilee">Choose Your Paratha</label>
                  <select id="paratha-choice-jubilee" class="card-select item-paratha-choice">
                    <option value="Whole Wheat">Whole Wheat (Healthy)</option>
                    <option value="Maida" selected>Maida</option>
                    <option value="Fried Paratha">Fried Paratha</option>
                  </select>
                </div>
                <div class="option-select-row">
                  <label for="protein-choice-jubilee">Protein Style</label>
                  <select id="protein-choice-jubilee" class="card-select item-protein-choice">
                    <option value="Paneer">Paneer (Veg)</option>
                    <option value="Chicken" selected>Chicken (Non-Veg)</option>
