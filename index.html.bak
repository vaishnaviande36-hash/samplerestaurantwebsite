                <button class="add-to-cart-btn" data-id="the-nuclear-bomb" data-name="THE NUCLEAR BOMB" data-price="309" data-img="assets/nuclear_bomb_wrap.png" aria-label="Add THE NUCLEAR BOMB to Cart">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>
          </div>

