        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>
    
    <div class="cart-body" id="cart-body">
      <!-- Empty state shown by default -->
      <div class="cart-empty-state" id="cart-empty-state">
        <i class="fa-solid fa-bag-shopping"></i>
        <p>Your bag is empty.<br>Go spice it up with our signature wraps!</p>
      </div>
      
      <!-- Cart items will be dynamically injected here by JS -->
      <div id="cart-items-container" style="display: none;"></div>
    </div>
    
    <div class="cart-footer-box" id="cart-footer-box" style="display: none;">
      <div class="cart-option-tabs">
        <button class="cart-opt-btn active" data-type="delivery">Delivery</button>
        <button class="cart-opt-btn" data-type="takeaway">Takeaway</button>
      </div>
      
      <div class="cart-summary-line">
        <span>Subtotal</span>
        <span id="cart-subtotal">₹0</span>
      </div>
      <div class="cart-summary-line">
        <span>GST (5%)</span>
        <span id="cart-gst">₹0</span>
      </div>
      <div class="cart-summary-line total">
        <span>Total</span>
        <span id="cart-total">₹0</span>
      </div>
      
      <button class="glow-btn checkout-btn" id="checkout-btn">
        <i class="fa-solid fa-check"></i> Place Order
      </button>
    </div>
  </div>

  <!-- ------------------------------------------------------------------------
       Interactive Table Booking Modal
       ------------------------------------------------------------------------ -->
  <div class="modal-overlay" id="booking-modal-overlay">
    <div class="booking-modal glass">
      <button class="close-modal-btn" id="close-modal-btn" aria-label="Close booking modal">
        <i class="fa-solid fa-xmark"></i>
      </button>
      
      <!-- Form state -->
      <div id="booking-form-container">
        <h2>Reserve a Table</h2>
        <p>Reserve a cozy street-food spot inside the Next Galleria Mall food court. No booking fees.</p>
        
        <form class="booking-form" id="booking-form" novalidate>
          <div class="form-group">
            <label for="booking-name">Full Name</label>
            <input type="text" id="booking-name" required placeholder="Your Name">
            <span class="error-message">Name is required.</span>
          </div>
          
          <div class="form-group">
            <label for="booking-phone">Phone Number</label>
            <input type="tel" id="booking-phone" required placeholder="081211 28462" pattern="[0-9]{10}">
            <span class="error-message">Enter a valid 10-digit mobile number.</span>
          </div>
          
          <div class="form-group">
            <label for="booking-date">Date</label>
            <input type="date" id="booking-date" required>
            <span class="error-message">Select a valid date.</span>
          </div>
          
          <div class="form-group">
            <label for="booking-time">Time Slot</label>
            <select id="booking-time" required>
              <option value="" disabled selected>Select Time</option>
              <option value="11:30">11:30 AM</option>
              <option value="13:00">1:00 PM</option>
              <option value="15:00">3:00 PM</option>
              <option value="17:00">5:00 PM</option>
              <option value="18:30">6:30 PM</option>
              <option value="20:00">8:00 PM</option>
              <option value="21:00">9:00 PM</option>
            </select>
            <span class="error-message">Select a time slot.</span>
          </div>
          
          <div class="form-group full-width">
            <label for="booking-guests">Number of Guests</label>
            <select id="booking-guests" required>
              <option value="2" selected>2 Guests</option>
              <option value="3">3 Guests</option>
              <option value="4">4 Guests</option>
              <option value="6">6+ Guests (Hangout Group)</option>
            </select>
          </div>
          
          <button type="submit" class="glow-btn">
            <i class="fa-solid fa-check"></i> Complete Reservation
          </button>
        </form>
      </div>
      
      <!-- Success state -->
      <div class="booking-success-state" id="booking-success-state">
        <div class="success-icon-circle">
          <i class="fa-solid fa-circle-check"></i>
        </div>
        <h3>Booking Confirmed!</h3>
        <p>Your table is reserved. A confirmation SMS has been sent to your registered mobile number.</p>
        <p style="margin-top: 15px; font-weight: 700; color: var(--primary-orange);">See you at Wisphot Galleria Mall!</p>
      </div>
    </div>
  </div>

  <!-- JavaScript Bundle -->
  <script src="app.js"></script>
</body>
</html>
