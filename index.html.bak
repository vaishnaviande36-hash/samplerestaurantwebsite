              <div class="card-footer">
                <span class="card-price">₹309</span>
                <button class="add-to-cart-btn" data-id="jubilee-hills" data-name="JUBILEE HILLS" data-price="309" data-img="assets/nuclear_bomb_wrap.png" aria-label="Add JUBILEE HILLS to Cart">
                  <i class="fa-solid fa-plus"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Item 3: The Nuclear Bomb -->
